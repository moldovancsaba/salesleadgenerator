# MongoDB Atlas connection string
MONGODB_URI=REDACTED_ROTATE_ME_2026-08-14

# Third-party integration hub (issue #217) — encrypts stored Google/Calendly
# credentials at rest. 32 raw bytes, base64-encoded (e.g. generate with
# `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`).
# Rotating this value permanently invalidates every existing connection —
# every brand must reconnect every provider afterward.
INTEGRATION_CREDENTIALS_ENCRYPTION_KEY=

# Shared Google OAuth client (one registration for the whole app, used by
# Google Calendar/Gmail/Google Contacts connections — issue #217)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# Note: Add this to Vercel Environment Variables for production deployment
