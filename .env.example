# MongoDB Atlas connection string
MONGODB_URI=REDACTED_ROTATE_ME_2026-08-14

# Third-party integration hub (issue #217) — encrypts stored Google/Calendly
# credentials at rest. 32 raw bytes, base64-encoded (e.g. generate with
# `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`).
# Rotating this value permanently invalidates every existing connection —
# every brand must reconnect every provider afterward.
INTEGRATION_CREDENTIALS_ENCRYPTION_KEY=

# Shared Google OAuth client (one registration for the whole app, used by
# Google Calendar/Gmail/Google Contacts connections — issue #217)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# Initial authority commissioning channel (issue #326). Default-off.
# Must be a 64-character hex string when configured.
SLG_AUTHORITY_PROVISIONING_TOKEN=
# Comma-separated list of at most three exact SHA-256 hashes of approved manifests.
SLG_AUTHORITY_MANIFEST_SHA256=

# Note: Add this to Vercel Environment Variables for production deployment

# Check-in scanner: shared access code used by any landing page whose scanner has no code of its own.
# Leave empty to require a code on every page.
HOSTESS_SCAN_PASSWORD=
